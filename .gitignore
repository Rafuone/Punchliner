node_modules/
dist/
*.log
.DS_Store
.env
# leaderboard du mode Survivor = donnée runtime (généré au 1er score), pas versionné
server/leaderboard.json
# cache disque du pool musical (métadonnées Deezer, régénéré au boot) — pas versionné
server/.pool-cache.json
# cache disque des EXTRAITS audio (mp3 rapatriés + préchauffés) + liste des injouables — runtime, lourd
server/.preview-cache/
server/.preview-dead.json
# fichier de relecture du quiz (régénéré depuis quiz-bank.json) — pas versionné
quiz-review.md

# Originaux bruts (réserve perso) — pas versionnés, restent en local.
# La musique servie par l'app (client/public/music/*.mp3) est versionnée via Git LFS.
assets/

# fonts.css est généré (getfonts.ps1) MAIS requis au build → on le versionne.

# secret Spotify (Client Credentials, local only)
server/.spotify-secret

# backups auto de la curation (créés par mergeCanonTracks/mergeAttach) — runtime, pas versionnés
server/*.json.bak
